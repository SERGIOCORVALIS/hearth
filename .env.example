# MCP server
MCP_PORT=3100
MCP_HOST=127.0.0.1

# Simulator → MCP (local only — part of the demo stack)
VITE_MCP_URL=http://127.0.0.1:3100/mcp
MCP_URL=http://127.0.0.1:3100/mcp

# --- Demo network (DEFAULT) ---
# Entire project ships as a self-contained demo. External AWS calls are virtual:
#   - Bedrock = offline MCP agent + Bedrock-shaped UI / awsServices
#   - CloudWatch = dry-run console payload (no PutLogEvents)
# Opt into real AWS networking only when you explicitly need it:
# HEARTH_LIVE_AWS=1
# HEARTH_DEMO=0
#
# Force the plain offline router (no Bedrock-shaped UI):
# HEARTH_FORCE_OFFLINE=1
#
# Optional simulated Converse latency (ms) for virtual Bedrock
# HEARTH_VIRTUAL_BEDROCK_MS=120

# AWS region / model ids (used as labels in demo mode; live only with HEARTH_LIVE_AWS=1)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CloudWatch log labels (demo = dry-run; live needs HEARTH_LIVE_AWS=1 + IAM)
# HEARTH_CLOUDWATCH_LOG_GROUP=/hearth/aws-builder
# HEARTH_CLOUDWATCH_LOG_STREAM=demo-local
# HEARTH_CLOUDWATCH_DRY_RUN=1

# --- Tunnel / hardening (optional; leave unset for local demo) ---
# Require Bearer / X-Hearth-Api-Key on MCP /mcp and simulator POST /api/chat
# HEARTH_API_KEY=change-me-before-tunneling

# CORS allowlist (comma-separated). Unset or * = reflective allow (demo default)
# HEARTH_CORS_ORIGINS=http://127.0.0.1:5173,https://YOUR.trycloudflare.com

# MCP session eviction
# HEARTH_SESSION_TTL_MS=1800000
# HEARTH_MAX_SESSIONS=100
# HEARTH_SESSION_SWEEP_MS=60000

# Sliding-window rate limit (req/min) on MCP /mcp and simulator POST /api/chat
# HEARTH_RATE_LIMIT_RPM=60

# Public HTTPS base when tunneled (used in OAuth PRM resource URLs)
# HEARTH_PUBLIC_BASE_URL=https://YOUR.trycloudflare.com

# OAuth/PRM scaffold (RFC 9728 + PKCE S256 stubs). Default on; set 0 to disable
# HEARTH_OAUTH_SCAFFOLD=1
