{
  "name": "streamable-http-mcp-starter",
  "version": "1.0.0",
  "description": "Minimal Alexa+-ready MCP server using Streamable HTTP (spec 2025-11-25)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "streamable-http-mcp-starter": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "alexa-plus",
    "amazon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SERGIOCORVALIS/streamable-http-mcp-starter"
  }
}
