{
  "name": "hearth",
  "version": "1.0.0",
  "private": true,
  "description": "Hearth — Alexa+ Family Concierge MCP server and web simulator",
  "workspaces": [
    "mcp-server",
    "simulator",
    "packages/shared"
  ],
  "scripts": {
    "mcp": "npm run start -w mcp-server",
    "mcp:dev": "npm run dev -w mcp-server",
    "sim": "npm run dev -w simulator",
    "sim:build": "npm run build -w simulator",
    "demo": "npm run build -w @hearth/shared && concurrently -k -n mcp,sim -c blue,magenta \"npm run mcp\" \"npm run sim\"",
    "demo:broll": "node scripts/demo-broll.mjs",
    "demo:prep": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-demo-record.ps1",
    "demo:tunnel-proof": "node scripts/tunnel-proof.mjs",
    "sanity": "node scripts/sanity-check.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "assets:addon": "node scripts/generate-addon-assets.mjs",
    "proof:bedrock": "tsx scripts/bedrock-proof.mjs",
    "addon:fill": "node scripts/fill-addon-json.mjs",
    "test": "npm run test -w mcp-server && npm run test -w simulator",
    "test:e2e": "playwright test",
    "test:oss": "npm --prefix oss/streamable-http-mcp-starter test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/tunnel-mcp.ps1",
    "oss:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-oss-starter.ps1",
    "collab:invite": "powershell -ExecutionPolicy Bypass -File ./scripts/add-amazon-collaborators.ps1",
    "build": "npm run build -w @hearth/shared && npm run build -w mcp-server && npm run build -w simulator",
    "typecheck": "npm run typecheck -w @hearth/shared && npm run typecheck -w mcp-server && npm run typecheck -w simulator"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
